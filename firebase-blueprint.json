{
  "entities": {
    "Trade": {
      "title": "Trade",
      "description": "A single trading position log",
      "type": "object",
      "properties": {
        "pair": { "type": "string", "description": "Trading pair name" },
        "type": { "type": "string", "enum": ["buy", "sell"], "description": "Trade type" },
        "entryPrice": { "type": "number", "description": "Price at entry" },
        "slPrice": { "type": "number", "description": "Stop loss price" },
        "tpPrice": { "type": "number", "description": "Take profit price" },
        "exitPrice": { "type": "number", "description": "Price at exit" },
        "rr": { "type": "number", "description": "Risk reward ratio" },
        "notes": { "type": "string", "description": "Personal trade notes/journal" },
        "userId": { "type": "string", "description": "Owner UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Log creation time" }
      },
      "required": ["pair", "type", "entryPrice", "slPrice", "tpPrice", "userId", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "geminiApiKey": { "type": "string", "description": "User-provided Gemini API key" }
      },
      "required": ["email", "role"]
    },
    "Journal": {
      "title": "Journal",
      "description": "Daily journal notes for a specific day",
      "type": "object",
      "properties": {
        "dateYMD": { "type": "string", "description": "Date formatted as YYYY-MM-DD" },
        "content": { "type": "string", "description": "Journal text content" },
        "userId": { "type": "string", "description": "Owner UID" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated" }
      },
      "required": ["dateYMD", "content", "userId", "updatedAt"]
    },
    "TradingAccount": {
      "title": "TradingAccount",
      "description": "Trading profile (live or backtest)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["live", "backtest", "other"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["name", "userId", "type", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Weekly or monthly trading performance review",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["weekly", "monthly"] },
        "periodKey": { "type": "string" },
        "periodTitle": { "type": "string" },
        "startDateYMD": { "type": "string" },
        "endDateYMD": { "type": "string" },
        "content": { "type": "string" },
        "userId": { "type": "string" },
        "accountId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["type", "periodKey", "periodTitle", "content", "userId", "updatedAt"]
    }
  },
  "firestore": {
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "Collection of trade logs"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/journals/{journalId}": {
      "schema": "Journal",
      "description": "Daily journal notes per day"
    },
    "/tradingAccounts/{accountId}": {
      "schema": "TradingAccount",
      "description": "User trading profiles"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Weekly and monthly review logs"
    }
  }
}

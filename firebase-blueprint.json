{
  "entities": {
    "Trade": {
      "title": "Trade",
      "description": "A single trading position log",
      "type": "object",
      "properties": {
        "pair": { "type": "string", "description": "Trading pair name" },
        "type": { "type": "string", "enum": ["buy", "sell"], "description": "Trade type" },
        "entryPrice": { "type": "number", "description": "Price at entry" },
        "slPrice": { "type": "number", "description": "Stop loss price" },
        "tpPrice": { "type": "number", "description": "Take profit price" },
        "exitPrice": { "type": "number", "description": "Price at exit" },
        "rr": { "type": "number", "description": "Risk reward ratio" },
        "notes": { "type": "string", "description": "Personal trade notes/journal" },
        "userId": { "type": "string", "description": "Owner UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Log creation time" }
      },
      "required": ["pair", "type", "entryPrice", "slPrice", "tpPrice", "userId", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "geminiApiKey": { "type": "string", "description": "User-provided Gemini API key" }
      },
      "required": ["email", "role"]
    },
    "Journal": {
      "title": "Journal",
      "description": "Daily journal notes for a specific day",
      "type": "object",
      "properties": {
        "dateYMD": { "type": "string", "description": "Date formatted as YYYY-MM-DD" },
        "content": { "type": "string", "description": "Journal text content" },
        "userId": { "type": "string", "description": "Owner UID" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated" }
      },
      "required": ["dateYMD", "content", "userId", "updatedAt"]
    }
  },
  "firestore": {
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "Collection of trade logs"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/journals/{journalId}": {
      "schema": "Journal",
      "description": "Daily journal notes per day"
    }
  }
}
